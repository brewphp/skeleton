# Machine-specific settings. Copy this file to .env (composer create-project
# does it for you) and never commit .env.

# Show detailed error pages. Always false in production.
DEBUG=true

# Signs sessions and other values. Generate one with: php manage.php key:generate
SECRET_KEY=

# Comma-separated domain names this site serves, e.g. example.com,.example.org
# With DEBUG=true and this empty, localhost addresses are allowed.
ALLOWED_HOSTS=

# Send the session and CSRF cookies only over HTTPS. Set to true in production.
SECURE_COOKIES=false

# Used to build absolute URLs outside a request (emails, commands).
APP_URL=http://127.0.0.1:8000

TIME_ZONE=UTC

# Database. Without these, SQLite is used with the file storage/db.sqlite3.
# DB_ENGINE=pgsql            # sqlite, mysql or pgsql
# DB_NAME=myapp              # database name (SQLite: file path)
# DB_HOST=127.0.0.1
# DB_PORT=5432               # default 3306 for mysql, 5432 for pgsql
# DB_USER=myapp
# DB_PASSWORD=
