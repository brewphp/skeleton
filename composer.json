{
    "name": "brewphp/skeleton",
    "description": "Starter project for BrewPHP, the small Django-inspired PHP framework.",
    "type": "project",
    "license": "MIT",
    "keywords": ["brewphp", "framework", "skeleton", "starter"],
    "homepage": "https://docs.brewphp.dev",
    "require": {
        "php": ">=8.2",
        "brewphp/brewphp": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php manage.php key:generate --ansi",
            "@php manage.php migrate --no-interaction --ansi"
        ],
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
